# SMTP alert delivery (keep real values only in .env, never commit them)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alerts@example.com
SMTP_PASS=replace-with-smtp-password-or-api-key
ALERT_MAIL_FROM=SolarSettle Alerts <alerts@example.com>
ALERT_RECIPIENTS=government-ops@example.com
ALERT_MAIL_PORT=8787
ALERT_MAIL_ORIGIN=http://localhost:3000
# All simulation, monitoring, and MetaMask transaction alerts go to ALERT_RECIPIENTS.
